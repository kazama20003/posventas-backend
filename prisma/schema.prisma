generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql" 
  url      = env("DATABASE_URL")
}

/*
  POS schema — modern, multi-tenant, inventory ledger, audited.
  IDs as UUIDs, timestamps, soft deletes, optimistic versioning.
*/

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  FULFILLED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  CASH
  CARD
  STRIPE
  PAYPAL
  OTHER
}

enum DocumentType {
  INVOICE
  RECEIPT
  CREDIT_NOTE
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  stores    Store[]
  users     User[]

  @@unique([name])
}

model Store {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  address     String?
  code        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // warehouse for stock
  warehouses Warehouse[]

  @@index([tenantId])
  @@unique([tenantId, code])
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  email      String
  password   String
  displayName String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  roles  UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  UserRole[]

  @@unique([tenantId, name])
}

model UserRole {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  roleId   String @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  parent   Category? @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  contact   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]
  @@index([tenantId])
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  name          String
  description   String?
  categoryId    String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@index([tenantId])
  @@unique([tenantId, name])
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  productId    String   @db.Uuid
  sku          String
  barcode      String? 
  attributes   Json?    // color/size etc as JSON
  cost         Float?   // last cost
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  product Product @relation(fields: [productId], references: [id])
  // stock per warehouse handled in Inventory
  inventories Inventory[]
  orderLines  OrderLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Warehouse {
  id       String  @id @default(uuid()) @db.Uuid
  storeId  String  @db.Uuid
  name     String
  code     String?
  createdAt DateTime @default(now())

  store Store @relation(fields: [storeId], references: [id])
  inventories Inventory[]
  movements InventoryMovement[]

  @@unique([storeId, code])
  @@index([storeId])
}

/*
  Inventory as ledger: the single source of truth for stock movements.
  Use Inventory for current snapshot per variant+warehouse.
  Use InventoryMovement for append-only ledger (increases traceability).
*/

model Inventory {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  variantId     String   @db.Uuid
  warehouseId   String   @db.Uuid
  quantity      Int      @default(0)
  reserved      Int      @default(0) // reservations for pending orders
  updatedAt     DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
  @@index([tenantId])
}

model InventoryMovement {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  variantId    String   @db.Uuid
  warehouseId  String   @db.Uuid
  delta        Int     // +in, -out
  reason       String  // e.g. "SALE", "PURCHASE", "ADJUSTMENT", "TRANSFER"
  referenceId  String? // orderId, purchaseOrderId, transferId
  createdById  String? @db.Uuid
  createdAt    DateTime @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
}

model PurchaseOrder {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  supplierId  String   @db.Uuid
  storeId     String?  @db.Uuid
  code        String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id])
  lines    PurchaseOrderLine[]

  @@index([tenantId])
  @@unique([tenantId, code])
}

model PurchaseOrderLine {
  id             String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @db.Uuid
  variantId      String   @db.Uuid
  quantity       Int
  unitCost       Float

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  addresses  CustomerAddress[]

  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
}

model CustomerAddress {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  line1      String
  line2      String?
  city       String?
  state      String?
  postalCode String?
  country    String?

  customer Customer @relation(fields: [customerId], references: [id])
}

model Order {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  storeId       String   @db.Uuid
  customerId    String?  @db.Uuid
  code          String
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  taxAmount     Float
  discountAmount Float @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  version       Int      @default(1) // optimistic lock

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  store    Store  @relation(fields: [storeId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  lines    OrderLine[]
  payments Payment[]

  @@index([tenantId, storeId])
  @@unique([tenantId, code])
}

model OrderLine {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  unitPrice Float
  lineTotal Float
  createdAt DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model Payment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  orderId      String?  @db.Uuid
  amount       Float
  provider     PaymentProvider
  providerRef  String?  // transaction id from gateway
  status       PaymentStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
}

model Document {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  storeId      String?  @db.Uuid
  orderId      String?  @db.Uuid
  type         DocumentType
  externalRef  String? // fiscal receipt id
  content      Json?   // raw payload for fiscal authority or printable template
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([tenantId, resource, resourceId])
}

/*
  Utility table: sequences, settings, etc.
*/
model AppSetting {
  id      String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  key     String
  value   String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}
