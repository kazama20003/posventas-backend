generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/*
  POS schema — modern, multi-tenant, inventory ledger, audited.
  IDs as UUIDs, timestamps, soft deletes, optimistic versioning.
*/

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  FULFILLED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  CASH
  CARD
  STRIPE
  PAYPAL
  OTHER
}

enum DocumentType {
  INVOICE
  RECEIPT
  CREDIT_NOTE
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (bidirectional)
  stores              Store[]
  users               User[]
  roles               Role[]
  categories          Category[]
  suppliers           Supplier[]
  products            Product[]
  productVariants     ProductVariant[]
  warehouses          Warehouse[]   
  inventories         Inventory[]
  inventoryMovements  InventoryMovement[]
  purchaseOrders      PurchaseOrder[]
  customers           Customer[]
  orders              Order[]
  payments            Payment[]
  documents           Document[]
  auditLogs           AuditLog[]
  appSettings         AppSetting[]

  @@unique([name])
  @@index([name])
}

model Store {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  address     String?
  code        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  // warehouse for stock
  warehouses Warehouse[]
  orders     Order[]
  purchaseOrders PurchaseOrder[]
  documents  Document[]

  @@index([tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
}

  model User {
    id          String   @id @default(uuid()) @db.Uuid
    tenantId    String   @db.Uuid
    
    email       String
    password    String

    displayName String?
    ruc         String?   @db.VarChar(11)
    phone       String?   @db.VarChar(20)

    isActive    Boolean   @default(true)
    lastLoginAt DateTime?
    deletedAt   DateTime?

    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    tenant Tenant @relation(fields: [tenantId], references: [id])
    roles  UserRole[]

    @@unique([tenantId, email])
    @@unique([tenantId, ruc])
    @@index([tenantId])
    @@index([tenantId, createdAt])
    @@index([phone])
  }


model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  users  UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model UserRole {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @db.Uuid
  roleId   String @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  parent   Category? @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")

  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  contact   String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model Product {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  name          String
  description   String?
  categoryId    String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@index([tenantId])
  @@unique([tenantId, name])
  @@index([tenantId, createdAt])
}

model ProductVariant {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  productId    String   @db.Uuid
  sku          String
  barcode      String?
  attributes   Json?    // color/size etc as JSON
  cost         Decimal? @db.Decimal(12,2) // last cost
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // stock per warehouse handled in Inventory
  inventories   Inventory[]
  orderLines    OrderLine[]
  movements     InventoryMovement[]
  purchaseLines PurchaseOrderLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model Warehouse {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  storeId   String  @db.Uuid
  name      String
  code      String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])

  inventories Inventory[]
  movements   InventoryMovement[]

  @@unique([storeId, code])
  @@index([tenantId])
  @@index([storeId])
  @@index([tenantId, createdAt])
}

/*
  Inventory as ledger: the single source of truth for stock movements.
  Use Inventory for current snapshot per variant+warehouse.
  Use InventoryMovement for append-only ledger (increases traceability).
*/

model Inventory {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @db.Uuid
  variantId     String   @db.Uuid
  warehouseId   String   @db.Uuid
  quantity      Int      @default(0)
  reserved      Int      @default(0) // reservations for pending orders
  updatedAt     DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
  @@index([tenantId])
  @@index([tenantId, updatedAt])
}

model InventoryMovement {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  variantId    String   @db.Uuid
  warehouseId  String   @db.Uuid
  delta        Int     // +in, -out
  reason       String  // e.g. "SALE", "PURCHASE", "ADJUSTMENT", "TRANSFER"
  referenceId  String? // orderId, purchaseOrderId, transferId
  createdById  String? @db.Uuid
  createdAt    DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model PurchaseOrder {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  supplierId  String   @db.Uuid
  storeId     String?  @db.Uuid
  code        String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  store    Store? @relation(fields: [storeId], references: [id])
  lines    PurchaseOrderLine[]

  @@index([tenantId])
  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
}

model PurchaseOrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @db.Uuid
  variantId       String   @db.Uuid
  quantity        Int
  unitCost        Decimal  @db.Decimal(12,2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
  @@index([variantId])
}

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  name       String
  email      String?
  phone      String?
  createdAt  DateTime @default(now())
  addresses  CustomerAddress[]
  orders     Order[]

  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model CustomerAddress {
  id         String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  line1      String
  line2      String?
  city       String?
  state      String?
  postalCode String?
  country    String?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

model Order {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  storeId        String   @db.Uuid
  customerId     String?  @db.Uuid
  code           String
  status         OrderStatus @default(PENDING)
  totalAmount    Decimal  @db.Decimal(12,2)
  taxAmount      Decimal  @db.Decimal(12,2)
  discountAmount Decimal  @db.Decimal(12,2) @default("0.00")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  version        Int      @default(1) // optimistic lock

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  store    Store  @relation(fields: [storeId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  lines    OrderLine[]
  payments Payment[]
  documents Document[]

  @@index([tenantId, storeId])
  @@unique([tenantId, code])
  @@index([tenantId, createdAt])
}

model OrderLine {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  unitPrice Decimal @db.Decimal(12,2)
  lineTotal Decimal @db.Decimal(12,2)
  createdAt DateTime @default(now())

  order   Order @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
}

model Payment {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  orderId      String?  @db.Uuid
  amount       Decimal  @db.Decimal(12,2)
  provider     PaymentProvider
  providerRef  String?  // transaction id from gateway
  status       PaymentStatus @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, createdAt])
}

model Document {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  storeId      String?  @db.Uuid
  orderId      String?  @db.Uuid
  type         DocumentType
  externalRef  String? // fiscal receipt id
  content      Json?   // raw payload for fiscal authority or printable template
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store? @relation(fields: [storeId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, resource, resourceId])
  @@index([tenantId, createdAt])
}

/*
  Utility table: sequences, settings, etc.
*/
model AppSetting {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  key      String
  value    String

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}
