generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/**
 * POS schema — modern, multi-tenant, inventory ledger, audited.
 * IDs as UUIDs, timestamps, soft deletes, optimistic versioning.
 */

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  FULFILLED
  CANCELED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentProvider {
  CASH
  CARD
  STRIPE
  PAYPAL
  OTHER
}

enum DocumentType {
  INVOICE
  RECEIPT
  CREDIT_NOTE
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELED
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum SubscriptionProvider {
  STRIPE
  OTHER
}

enum SubscriptionPaymentMethod {
  YAPE
  STRIPE
  CARD
  CASH
  BANK_TRANSFER
  PAYPAL
  OTHER
}

/**
 * Sequence generator for human-readable codes.
 * Example keys:
 * - ORDER:STORE:<storeId>
 * - PO:STORE:<storeId>
 * - DOC:STORE:<storeId>:INVOICE
 */
model Sequence {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String

  /// ✅ para URLs tipo /mi-empresa (multi-tenant frontend)
  slug      String   @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations (bidirectional)
  stores             Store[]
  users              User[]
  roles              Role[]
  categories         Category[]
  suppliers          Supplier[]
  products           Product[]
  productVariants    ProductVariant[]
  warehouses         Warehouse[]
  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  customers          Customer[]
  orders             Order[]
  payments           Payment[]
  documents          Document[]
  auditLogs          AuditLog[]
  appSettings        AppSetting[]
  sequences          Sequence[]
  subscription       Subscription?

  // ❌ NO pongas unique global por name (pueden existir nombres repetidos)
  @@index([name])
  @@index([deletedAt])
  @@index([slug])
}

model Subscription {
  id                     String               @id @default(uuid()) @db.Uuid
  tenantId               String               @db.Uuid

  plan                   SubscriptionPlan     @default(FREE)
  status                 SubscriptionStatus   @default(TRIALING)
  provider               SubscriptionProvider @default(STRIPE)

  providerCustomerId     String?
  providerSubscriptionId String?

  /// (Opcional) Puedes dejarlo, pero NO lo uses como “verdad” de pago recurrente
  paymentMethods         SubscriptionPaymentMethod[]

  /// ✅ SaaS real: periodo actual
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?

  /// ✅ trial real
  trialEndsAt            DateTime?

  cancelAtPeriodEnd      Boolean              @default(false)
  canceledAt             DateTime?

  /// ✅ para debugging / salud de webhooks
  lastProviderEventAt    DateTime?

  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  deletedAt              DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, deletedAt])
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  address   String?
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  // warehouse for stock
  warehouses     Warehouse[]
  orders         Order[]
  purchaseOrders PurchaseOrder[]
  documents      Document[]

  /// ✅ acceso por sucursal (opcional pero recomendado)
  userStores UserStore[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model User {
  id       String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid

  email    String
  password String

  displayName String?
  ruc         String? @db.VarChar(11)
  phone       String? @db.VarChar(20)

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  deletedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  roles  UserRole[]

  // ✅ inverse relation for InventoryMovement.createdBy
  inventoryMovementsCreated InventoryMovement[] @relation("InventoryMovementCreatedBy")

  /// ✅ acceso por sucursal (opcional)
  stores UserStore[]

  @@unique([tenantId, email])
  @@unique([tenantId, ruc])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([phone])
  @@index([tenantId, deletedAt])
}

/// ✅ tabla para controlar a qué sucursales puede entrar cada usuario
model UserStore {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  storeId   String   @db.Uuid
  createdAt DateTime @default(now())
  deletedAt DateTime?

  user  User  @relation(fields: [userId], references: [id])
  store Store @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
  @@index([deletedAt])
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  createdAt DateTime @default(now())
  deletedAt DateTime?

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  users  UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
}

model UserRole {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  parentId  String?  @db.Uuid
  createdAt DateTime @default(now())
  deletedAt DateTime?

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryChildren", fields: [parentId], references: [id])
  children Category[] @relation("CategoryChildren")
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  categoryId  String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model ProductVariant {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  productId  String   @db.Uuid
  sku        String
  barcode    String?
  attributes Json?
  cost       Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  inventories   Inventory[]
  orderLines    OrderLine[]
  movements     InventoryMovement[]
  purchaseLines PurchaseOrderLine[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, productId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model Warehouse {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  storeId   String   @db.Uuid
  name      String
  code      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])

  inventories Inventory[]
  movements   InventoryMovement[]

  @@unique([storeId, code])
  @@index([tenantId])
  @@index([storeId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model Inventory {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  variantId   String   @db.Uuid
  warehouseId String   @db.Uuid
  quantity    Int      @default(0)
  reserved    Int      @default(0)
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
  @@index([tenantId])
  @@index([tenantId, updatedAt])
  @@index([tenantId, deletedAt])
}

model InventoryMovement {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  variantId   String   @db.Uuid
  warehouseId String   @db.Uuid
  delta       Int
  reason      String
  referenceId String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now())
  deletedAt   DateTime?

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])

  // ✅ named relation + matches inverse in User
  createdBy User? @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, variantId, createdAt])
  @@index([tenantId, deletedAt])
}

model PurchaseOrder {
  id         String              @id @default(uuid()) @db.Uuid
  tenantId   String              @db.Uuid
  supplierId String              @db.Uuid
  storeId    String?             @db.Uuid
  code       String
  status     PurchaseOrderStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  deletedAt  DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])
  store    Store?   @relation(fields: [storeId], references: [id])
  lines    PurchaseOrderLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, deletedAt])
}

model PurchaseOrderLine {
  id              String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String   @db.Uuid
  variantId       String   @db.Uuid
  quantity        Int
  unitCost        Decimal  @db.Decimal(12, 2)
  deletedAt       DateTime?

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
  @@index([variantId])
  @@index([deletedAt])
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  addresses CustomerAddress[]
  orders    Order[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  line1      String
  line2      String?
  city       String?
  state      String?
  postalCode String?
  country    String?
  deletedAt  DateTime?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([deletedAt])
}

model Order {
  id         String      @id @default(uuid()) @db.Uuid
  tenantId   String      @db.Uuid
  storeId    String      @db.Uuid
  customerId String?     @db.Uuid
  code       String
  status     OrderStatus @default(PENDING)

  totalAmount    Decimal @default("0.00") @db.Decimal(12, 2)
  taxAmount      Decimal @default("0.00") @db.Decimal(12, 2)
  discountAmount Decimal @default("0.00") @db.Decimal(12, 2)

  /// ✅ anti-duplicados por reintentos del POS
  idempotencyKey String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  version Int @default(1)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  store    Store     @relation(fields: [storeId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  lines     OrderLine[]
  payments  Payment[]
  documents Document[]

  @@unique([tenantId, code])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, storeId])
  @@index([tenantId, storeId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, deletedAt])
}

model OrderLine {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  variantId String   @db.Uuid
  quantity  Int
  unitPrice Decimal  @db.Decimal(12, 2)
  lineTotal Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  deletedAt DateTime?

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([variantId])
  @@index([deletedAt])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  orderId     String?       @db.Uuid
  amount      Decimal       @db.Decimal(12, 2)
  provider    PaymentProvider
  providerRef String?
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order?  @relation(fields: [orderId], references: [id])

  @@index([tenantId, orderId])
  @@index([tenantId, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, deletedAt])
}

model Document {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  storeId     String?      @db.Uuid
  orderId     String?      @db.Uuid
  type        DocumentType
  externalRef String?
  content     Json?
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store?  @relation(fields: [storeId], references: [id])
  order  Order?  @relation(fields: [orderId], references: [id])

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, deletedAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  userId     String?  @db.Uuid
  action     String
  resource   String
  resourceId String?
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, resource, resourceId])
  @@index([tenantId, createdAt])
}

model AppSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     String
  deletedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
  @@index([tenantId])
  @@index([tenantId, deletedAt])
}
